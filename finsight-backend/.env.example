# Copy to .env (git-ignored) for local development, or set these as real environment variables.
DB_URL=jdbc:postgresql://localhost:5432/finsight
DB_USERNAME=postgres
DB_PASSWORD=change-me

# Required in production (SPRING_PROFILES_ACTIVE=prod). Generate with: openssl rand -base64 48
FINSIGHT_JWT_SECRET=

# Optional
# SPRING_PROFILES_ACTIVE=dev
# PORT=8080
# DB_POOL_SIZE=10
# FINSIGHT_API_DOCS_ENABLED=false
